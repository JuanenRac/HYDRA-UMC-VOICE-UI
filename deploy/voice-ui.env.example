# Create /etc/hydra-umc/voice-ui.env directly on the CM5. Generate a long,
# unique value locally and copy the SAME value to HYDRA_UMC_VOICE_UI_TOKEN in
# /etc/hydra-umc/server.env. Never commit either populated file.
HYDRA_UMC_VOICE_UI_TOKEN=SET_LOCALLY_TO_A_LONG_RANDOM_VALUE
# Signs the confirmation tokens (at least 16 characters, never reused elsewhere).
HYDRA_UMC_VOICE_UI_CONFIRM_SECRET=SET_LOCALLY_TO_A_LONG_RANDOM_VALUE
# A spoken stop is answered at once, without a confirmation. Set 1 to ask for one (starting a movement is always confirmed).
# HYDRA_UMC_VOICE_UI_STOP_REQUIRES_CONFIRMATION=1
# The risk level of each spoken action (status, stop, start a mission, go home) comes from a JSON file; see voice-ui-risk.json.example.
# Without the file a status request and a stop are answered at once and a movement always needs a confirmation. The file can only make that stricter.
# HYDRA_UMC_VOICE_UI_RISK_FILE=/etc/hydra-umc/voice-ui-risk.json
