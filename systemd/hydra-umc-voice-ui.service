[Unit]
Description=HYDRA-UMC-VOICE-UI bounded local voice gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydra-umc-voice-ui
Group=hydra-umc-voice-ui
WorkingDirectory=/opt/hydra-umc/voice-ui
EnvironmentFile=/etc/hydra-umc/voice-ui.env
Environment=PYTHONPATH=/opt/hydra-umc/voice-ui/src
ExecStart=/usr/bin/python3 -m hydra_umc_voice_ui.main serve --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
